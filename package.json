{
  "author": "Rushikesh Pandit <rushikesh.d.pandit@gmail.com> (https://github.com/rushikeshpandit)",
  "bugs": {
    "url": "https://github.com/rushikeshpandit/react-native-i18n-kit/issues"
  },
  "codegenConfig": {
    "android": {
      "javaPackageName": "com.i18nkit"
    },
    "jsSrcsDir": "src",
    "name": "I18nKitSpec",
    "type": "modules"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it",
      "vite"
    ],
    "type": "turbo-module",
    "version": "0.63.0"
  },
  "description": "Fully native, zero-dependency localization toolkit for React Native. TurboModule + Fabric ready, New Architecture native, 16 KB page-size compliant on Android 15+, built with Kotlin and Swift.",
  "devDependencies": {
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19",
    "commitlint": "^21.0.2",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-web": "~0.21.2",
    "react-test-renderer": "19.2.3",
    "release-it": "^20.2.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "react-native-i18n-kit-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "homepage": "https://github.com/rushikeshpandit/react-native-i18n-kit#readme",
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/example/ios"
    ],
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "react-native-i18n-kit-source"
      ]
    },
    "moduleNameMapper": {
      "^react-native-i18n-kit$": "<rootDir>/src/index.tsx",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^react-native$": "<rootDir>/node_modules/react-native",
      "^react-native/(.*)$": "<rootDir>/node_modules/react-native/$1",
      "^react-native-safe-area-context$": "<rootDir>/example/node_modules/react-native-safe-area-context",
      "^react-native-safe-area-context/jest/mock$": "<rootDir>/example/node_modules/react-native-safe-area-context/jest/mock"
    }
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "i18n",
    "l10n",
    "localization",
    "internationalization",
    "locale",
    "translation",
    "language-switcher",
    "rtl",
    "right-to-left",
    "device-locale",
    "turbomodule",
    "turbo-module",
    "new-architecture",
    "fabric",
    "jsi",
    "codegen",
    "kotlin",
    "swift",
    "swiftui",
    "zero-dependency",
    "no-dependencies",
    "16kb",
    "16-kb-page-size",
    "android-15",
    "page-size-compliance",
    "native-module"
  ],
  "license": "MIT",
  "main": "./lib/module/index.js",
  "name": "react-native-i18n-kit",
  "packageManager": "yarn@4.11.0",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "react-native-builder-bob": {
    "output": "lib",
    "source": "src",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rushikeshpandit/react-native-i18n-kit.git"
  },
  "scripts": {
    "build:web": "vite build",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "example": "yarn workspace react-native-i18n-kit-example",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "release": "release-it --only-version",
    "test": "jest",
    "typecheck": "tsc",
    "web": "vite"
  },
  "types": "./lib/typescript/src/index.d.ts",
  "version": "1.1.0",
  "workspaces": [
    "example"
  ]
}
